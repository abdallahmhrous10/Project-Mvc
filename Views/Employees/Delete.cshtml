@model EmployeeViewModel

@{
    ViewData["Title"] = "Delete Employee";
}

<h1 class="text-danger">Delete @Model.Name?</h1>

@if (!string.IsNullOrWhiteSpace(Model.ImageName))
{
    <div class="mb-3">
        <img src="~/Files/Images/@Model.ImageName"
             alt="@Model.Name"
             width="120"
             height="120"
             class="rounded"
             style="object-fit: cover;" />
    </div>
}

<form method="post"
      asp-action="Delete"
      asp-route-id="@Model.Id">

    <input type="hidden" asp-for="Id" />

    <partial name="PartialViews/DetailsDeletePartial" model="Model" />

    <div class="mt-3">
        <button class="btn btn-danger" type="submit">Delete</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </div>

</form>
