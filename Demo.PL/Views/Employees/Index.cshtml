@model PaginatedList<EmployeeViewModel>

@{
    ViewData["Title"] = "Employees";

    var currentSearch =
        Context.Request.Query["searchValue"].ToString();
}

<a asp-action="Create"
   class="btn btn-primary mt-3">
    Create New Employee
</a>

<div class="mt-3 container">
    <form asp-action="Index"
          method="get"
          class="row">

        <div class="col-10">
            <input class="form-control"
                   placeholder="Employee's Name"
                   name="searchValue"
                   value="@currentSearch" />
        </div>

        <div class="col-2 mt-2">
            <input type="submit"
                   class="btn btn-info"
                   value="Search" />
        </div>
    </form>
</div>

@if (Model.Any())
{
    <div class="table-responsive mt-3">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Age</th>
                    <th>Department</th>
                    <th>Salary</th>
                    <th>Address</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Active</th>
                    <th>Details</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(employee.ImageName))
                            {
                                <img src="~/Files/Images/@employee.ImageName"
                                     alt="@employee.Name"
                                     width="55"
                                     height="55"
                                     style="object-fit:cover"
                                     class="rounded" />
                            }
                            else
                            {
                                <span>No Image</span>
                            }
                        </td>

                        <td>@employee.Name</td>
                        <td>@employee.Age</td>
                        <td>@employee.Department?.Name</td>

                        <td>
                            @Html.DisplayFor(e => employee.Salary)
                        </td>

                        <td>@employee.Address</td>

                        <td>
                            @Html.DisplayFor(e => employee.Email)
                        </td>

                        <td>@employee.Phone</td>

                        <td>
                            @if (employee.IsActive)
                            {
                                <i class="fa-solid fa-circle"
                                   style="color:green"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-circle"
                                   style="color:red"></i>
                            }
                        </td>

                        <partial name="_ButtonsPartial"
                                 model="@employee.Id" />
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Employee pages">
        <ul class="pagination">

            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-searchValue="@currentSearch"
                   asp-route-pageIndex="@(Model.PageIndex - 1)">
                    Previous
                </a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">
                    Page @Model.PageIndex of @Model.TotalPages
                </span>
            </li>

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-searchValue="@currentSearch"
                   asp-route-pageIndex="@(Model.PageIndex + 1)">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}
else
{
    <div class="alert alert-warning mt-3">
        No Employees Found.
    </div>
}
